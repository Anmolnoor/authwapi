---
interface Props {
  size?: number;
}
const { size = 24 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  class="aw-brand-mark"
>
  <rect
    x="1.75"
    y="1.75"
    width="20.5"
    height="20.5"
    rx="6"
    fill="var(--aw-accent-soft)"
    stroke="var(--aw-accent)"
    stroke-width="1.75"
  />
  <path
    d="M12 6.9a2.7 2.7 0 0 1 2.7 2.7c0 1.05-.6 1.96-1.48 2.41l.6 4.39h-3.64l.6-4.39A2.7 2.7 0 0 1 12 6.9Z"
    fill="var(--aw-accent-hi)"
  />
</svg>

<style>
  .aw-brand-mark {
    flex-shrink: 0;
    display: block;
  }
</style>
