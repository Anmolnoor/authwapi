# ---- Runtime ----
NODE_ENV=development
PORT=8000
LOG_LEVEL=info

# ---- Database ----
DATABASE_URL=mongodb://127.0.0.1:27017/authwapi

# ---- JWT ----
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=30d

# ---- Email (SMTP, used by the forgot-password flow) ----
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USERNAME=your-smtp-username
EMAIL_PASSWORD=your-smtp-password
# Full URL with scheme and trailing slash; the reset token is appended.
EMAIL_URL=http://localhost:8000/api/v1/auth/reset-password/

# ---- AWS S3 (used by the image-upload flow) ----
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=your-bucket-name
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your-secret-access-key
